NODE_ENV=development
PORT=8080

# Enable the private WhisperX alignment worker only when it is deployed.
VERSEVISION_ALIGNMENT_WORKER_URL=
VERSEVISION_ALIGNMENT_WORKER_TOKEN=
VERSEVISION_ALIGNMENT_JOBS_ENABLED=0

# Durable job/audio storage. Leave unset for the local memory fallback.
VERSEVISION_ALIGNMENT_STORE=memory
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VERSEVISION_ALIGNMENT_BUCKET=versevision-audio

# Full paid blueprint route remains disabled until an x402 verifier is wired.
VERSEVISION_BLUEPRINT_ENABLED=0
